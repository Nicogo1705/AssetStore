<a class="card" href="@($"a/{Uri.EscapeDataString(Asset.Id)}")"
   @onpointerenter="() => _hover = true" @onpointerleave="() => _hover = false">
    <div class="card-thumb">
        @Initial
        @if (ThumbUrl is not null)
        {
            <img class="thumb-img" src="@ThumbUrl" alt="" loading="lazy"
                 onload="this.style.display=''" onerror="this.style.display='none'" />
        }
        @* Motion sells: on hover, the first animated media of the manifest plays over the
           static thumbnail (loaded lazily — nothing is fetched until the first hover). *@
        @if (_hover && HoverMediaUrl is not null)
        {
            @if (HoverMediaIsVideo)
            {
                <video class="thumb-img hover-media" src="@HoverMediaUrl" autoplay muted loop playsinline></video>
            }
            else
            {
                <img class="thumb-img hover-media" src="@HoverMediaUrl" alt=""
                     onerror="this.style.display='none'" />
            }
        }
    </div>
    <div class="card-body">
        <div class="card-title">@Asset.Manifest.Name</div>
        <div class="card-desc">@Asset.Manifest.Description</div>
        <div class="card-meta">
            <span class="badge cat">@Asset.Manifest.Category</span>
            @if (Asset.Latest.DetectedStrideVersion is not null)
            {
                <span class="badge stride">Stride @Asset.Latest.DetectedStrideVersion</span>
            }
            @if (Asset.Certified.Count > 0)
            {
                <span class="badge certified"
                      title="Certified: this version was reviewed by the registry maintainers and is pinned to an immutable commit.">
                    ✔ certified
                </span>
            }
            @if (Asset.Manifest.Nuget is not null)
            {
                <span class="badge nuget">NuGet</span>
            }
            @if (Asset.Stars is { } stars)
            {
                <span class="badge stars">★ @stars</span>
            }
            @if (Asset.ValidationStatus is "error" or "unavailable")
            {
                <span class="badge warn">⚠ @Asset.ValidationStatus</span>
            }
        </div>
        @if (Asset.Manifest.Tags.Count > 0)
        {
            <div class="card-tags">
                @foreach (var tag in _tagsExpanded ? Asset.Manifest.Tags : Asset.Manifest.Tags.Take(3))
                {
                    @* Inside the card's <a>: preventDefault keeps the click from navigating. *@
                    <button type="button" class="tag-chip" title="@($"Filter by #{tag}")"
                            @onclick="() => OnTagClick.InvokeAsync(tag)"
                            @onclick:preventDefault @onclick:stopPropagation>#@tag</button>
                }
                @if (Asset.Manifest.Tags.Count > 3)
                {
                    @if (_tagsExpanded)
                    {
                        <button type="button" class="tag-chip tag-more" title="Show fewer tags"
                                @onclick="() => _tagsExpanded = false"
                                @onclick:preventDefault @onclick:stopPropagation>−</button>
                    }
                    else
                    {
                        <button type="button" class="tag-chip tag-more" title="@($"Show all {Asset.Manifest.Tags.Count} tags")"
                                @onclick="() => _tagsExpanded = true"
                                @onclick:preventDefault @onclick:stopPropagation>+@(Asset.Manifest.Tags.Count - 3)</button>
                    }
                }
            </div>
        }
    </div>
</a>

@code {
    private static readonly string[] VideoExtensions = [".mp4", ".webm"];
    private static readonly string[] AnimatedImageExtensions = [".gif", ".apng"];

    private bool _hover;
    private bool _tagsExpanded;

    [Parameter, EditorRequired]
    public IndexedAsset Asset { get; set; } = default!;

    /// <summary>Raised when a tag chip is clicked (the grid filters on it).</summary>
    [Parameter]
    public EventCallback<string> OnTagClick { get; set; }

    private string Initial =>
        string.IsNullOrEmpty(Asset.Manifest.Name) ? "?" : Asset.Manifest.Name[..1].ToUpperInvariant();

    // thumbnail/media paths are relative to the repository root (display-only, not cloned into projects).
    private string? ThumbUrl =>
        string.IsNullOrEmpty(Asset.Manifest.Thumbnail)
            ? null
            : GitLinks.RawRepoFile(Asset.Repo, Asset.Latest.Commit, Asset.Manifest.Thumbnail);

    /// <summary>First animated media (gif/apng/mp4/webm) of the manifest, or null — static images
    /// wouldn't add anything over the thumbnail.</summary>
    private string? HoverMedia => Asset.Manifest.Media.FirstOrDefault(m =>
        VideoExtensions.Concat(AnimatedImageExtensions).Any(e => m.EndsWith(e, StringComparison.OrdinalIgnoreCase)));

    private string? HoverMediaUrl =>
        HoverMedia is null ? null : GitLinks.RawRepoFile(Asset.Repo, Asset.Latest.Commit, HoverMedia);

    private bool HoverMediaIsVideo =>
        HoverMedia is { } m && VideoExtensions.Any(e => m.EndsWith(e, StringComparison.OrdinalIgnoreCase));
}
