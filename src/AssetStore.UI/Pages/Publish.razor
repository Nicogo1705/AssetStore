@* Copyright (c) <YEAR> <COPYRIGHT HOLDER> - MIT license *@
@page "/publish"
@page "/manage"
@inject NavigationManager Nav
@implements IDisposable
@using System.Text.RegularExpressions
@using AssetStore.Core.Models
@using AssetStore.Core.Serialization
@inject GitHubAuth Auth
@inject GitHubPublisher Publisher
@inject ICliPublisher Cli
@inject RegistryOptions Registry
@inject AppEnvironment Env
@inject HttpClient Http
@using AssetStore.App.Services

<PageTitle>Manage store assets — Community Stride Asset Store</PageTitle>

<a class="back" href="">← Back to catalog</a>
<h1 style="margin:.2rem 0 .3rem">Manage store assets</h1>
<p class="lead">
    Publish, certify or remove assets in
    <a href="@($"https://github.com/{Registry.Owner}/{Registry.Repo}")" target="_blank" rel="noopener">@Registry.Owner/@Registry.Repo</a>.
    Every action is a <strong>pull request</strong> against the registry — nothing about your asset is copied or re-hosted;
    the store always reads it live from your repo.
</p>

<div class="modes" role="tablist">
    <button class="mode @(_tab == Tab.Publish ? "active" : "")" role="tab" @onclick="() => SelectTab(Tab.Publish)">📦 Publish</button>
    <button class="mode @(_tab == Tab.Certify ? "active" : "")" role="tab" @onclick="() => SelectTab(Tab.Certify)">✓ Certify a version</button>
    <button class="mode @(_tab == Tab.Remove ? "active" : "")" role="tab" @onclick="() => SelectTab(Tab.Remove)">🗑 Remove</button>
    @if (Env.InstallAvailable)
    {
        <a class="mode" style="margin-left:auto;text-decoration:none" href="manage/new-asset"
           title="Create a ready-to-publish asset repo from the template — repo, renames, manifest, first push">🧙 New asset</a>
    }
    <a class="mode" style="@(Env.InstallAvailable ? "" : "margin-left:auto;")text-decoration:none" href="manage/manifest-generator"
       title="Interactive form that writes a valid manifest.json for your asset">🧾 Manifest generator</a>
</div>

@if (_tab == Tab.Publish)
{
    <!-- ─────────────────────────────  Prepare  ───────────────────────────── -->
    <section class="panel">
        <h2>1 · Prepare your repository</h2>
        <p class="install-hint" style="margin-bottom:1rem">
            On install the store clones <strong>only your <code>AssetData/</code> folder</strong> — keep it to the
            <code>manifest.json</code> and your Stride project. Display-only files (<code>README.md</code>,
            <code>thumbnail.png</code>, <code>media/</code>, <code>LICENSE.md</code>) live at the <strong>repository
            root</strong>: the store reads them for the catalog page but never clones them into projects.
        </p>

        <div class="tracked">
            <div class="tracked-tree" aria-hidden="true"><span class="t-dim">your-repo/</span>
├─ <span class="t-file">README.md</span>
├─ <span class="t-file">thumbnail.png</span>
├─ <span class="t-dir">media/</span>
│  └─ …
├─ <span class="t-file">LICENSE.md</span>
└─ <span class="t-dir">AssetData/</span> <span class="t-dim">← the only folder cloned into projects</span>
   ├─ <span class="t-file req">manifest.json</span>
   └─ <span class="t-dir">YourAsset/</span> <span class="t-dim">(.csproj, .sdpkg, .cs …)</span></div>

            <dl class="tracked-docs">
                <div class="trackfile">
                    <dt><span class="t-ico">📄</span><code>manifest.json</code><span class="pill req">required</span></dt>
                    <dd>
                        The machine-readable description of your asset — id, name, category, license, tags, thumbnail,
                        media and import mode. It is validated live against the
                        <a href="@($"https://github.com/{Registry.Owner}/{Registry.Repo}/blob/{Registry.BaseBranch}/schemas/manifest.schema.json")" target="_blank" rel="noopener">JSON schema</a>
                        in CI when your pull request runs.
                        <a href="manage/manifest-generator">Generate it →</a>
                    </dd>
                </div>
                <div class="trackfile">
                    <dt><span class="t-ico">📘</span><code>README.md</code><span class="pill">recommended</span></dt>
                    <dd>
                        Your asset's landing page. Rendered as Markdown on the detail page (raw HTML is stripped for
                        safety, so scripts and iframes won't run). Put the full documentation and usage here — the
                        <code>description</code> field in the manifest is only a one-line summary. Screenshots come from
                        the <code>media/</code> gallery, so you don't need images in the README.
                        <div style="margin-top:.5rem"><button class="btn" @onclick="CopyReadmeTemplate">📋 Copy README template</button></div>
                    </dd>
                </div>
                <div class="trackfile">
                    <dt><span class="t-ico">🖼</span><code>thumbnail.png</code><span class="pill">optional</span></dt>
                    <dd>
                        The square cover image shown on catalog cards and the detail header. Roughly
                        <strong>512×512</strong> works best. Keep it at the <strong>repo root</strong> (display-only, not
                        cloned) and point <code>manifest.thumbnail</code> at its path relative to the repository root.
                        Without one, the store draws a lettered placeholder.
                    </dd>
                </div>
                <div class="trackfile">
                    <dt><span class="t-ico">🎞</span><code>media/…</code><span class="pill">optional</span></dt>
                    <dd>
                        Screenshots and short clips shown in the gallery and lightbox on the asset page. List their paths
                        (relative to the <strong>repository root</strong>) in <code>manifest.media</code> — keep them at the
                        root so they aren't cloned. Images and video are both supported — <code>.png</code>, <code>.jpg</code>,
                        <code>.mp4</code>, <code>.webm</code> — up to 40 items. (For packs whose media <em>is</em> the content,
                        e.g. textures, point at <code>AssetData/…</code>.)
                    </dd>
                </div>
                <div class="trackfile">
                    <dt><span class="t-ico">⚖</span><code>LICENSE.md</code><span class="pill">recommended</span></dt>
                    <dd>
                        Your license text. The SPDX identifier (e.g. <code>MIT</code>) goes in <code>manifest.license</code>
                        and must be one of the store's
                        <a href="@($"https://github.com/{Registry.Owner}/{Registry.Repo}/blob/{Registry.BaseBranch}/catalog/licenses.json")" target="_blank" rel="noopener">accepted licenses</a>.
                        Assets without a clear license are hard to reuse.
                    </dd>
                </div>
                <div class="trackfile">
                    <dt><span class="t-ico">🧩</span><code>YourAsset/</code> — the Stride project<span class="pill req">required</span></dt>
                    <dd>
                        The actual content: your <code>.csproj</code>, <code>.sdpkg</code> package, <code>.sd*</code> assets,
                        scripts, shaders and resources. The store reads your <strong>Stride version</strong> from the
                        <code>Stride.*</code> <code>PackageReference</code> in the <code>.csproj</code>, and detects
                        dependencies from its <code>&lt;ProjectReference&gt;</code> entries. On a local install this is what
                        gets cloned and wired in with a <code>&lt;ProjectReference&gt;</code>.
                    </dd>
                </div>
            </dl>
        </div>

        <p class="install-hint callout">
            🚀 <strong>Starting from scratch?</strong>
            <a href="https://github.com/Nicogo1705/StrideAssetTemplate/generate" target="_blank" rel="noopener">Use the asset template →</a>
            One click gives you this exact structure — manifest, example script, runnable demo and a
            publishing checklist (<code>PUBLISHING.md</code>).
        </p>

        <p class="install-hint callout">
            📦 <strong>Also on NuGet?</strong> If your asset is published as a NuGet package
            (<a href="https://doc.stride3d.net/latest/en/manual/files-and-folders/external-packages/publish-a-nuget-package.html"
               target="_blank" rel="noopener">how to publish a NuGet package for Stride →</a>),
            declare it in the manifest — <code>nuget.packageId</code>, plus <code>defaultImport: "nuget"</code> if that
            should be the recommended install. The store then offers a <code>&lt;PackageReference&gt;</code> install next
            to the source clone. The <a href="manage/manifest-generator">manifest generator</a> has both fields.
        </p>

        <p class="install-hint callout">
            💡 <strong>Commit &amp; push before you submit.</strong> The registry validates your repository at the tracked
            ref, so <code>AssetData/manifest.json</code> and the rest must already be there.
        </p>
    </section>

    <!-- ─────────────────────────────  Submit  ───────────────────────────── -->
    <section class="panel">
        <h2>2 · Submit to the registry</h2>
        <p class="install-hint">
            Point us at your asset. Both methods below open a pull request adding
            <code>registry/@(DisplayId).json</code> — the tiny pointer the bot reads your manifest from.
            You never re-enter your manifest here; even the asset id is read from it.
        </p>

        <div class="form">
            <label class="wide">Asset repo URL<input class="ipt" @bind="_repoUrl" @bind:event="oninput" @bind:after="DetectIdAsync" placeholder="https://github.com/you/CoolAsset" /></label>
            <label>Tracked ref (branch or tag)<input class="ipt" @bind="_ref" @bind:event="oninput" @bind:after="DetectIdAsync" placeholder="main" /></label>
        </div>

        <p class="install-hint" aria-live="polite" style="margin-top:.5rem">
            @if (_detecting)
            {
                <span>⏳ Reading <code>AssetData/manifest.json</code>…</span>
            }
            else if (_detectedId is not null)
            {
                <span>✓ Asset id detected from your manifest: <strong><code>@_detectedId</code></strong></span>
            }
            else if (_detectError is not null)
            {
                <span>⚠ @_detectError</span>
            }
            else
            {
                <span>The asset id is read automatically from <code>AssetData/manifest.json</code> at the tracked ref.</span>
            }
        </p>

        <MethodPicker @bind-Method="_method" ShowCli="ShowCliTab" />

        @if (_method == PublishMethod.Assisted)
        {
            <AssistedPrPanel Description="Sign in with a GitHub token and the store forks the registry (if needed), commits the pointer file and opens the pull request for you — all from your browser."
                             ButtonLabel="Open pull request"
                             Busy="_busy" CanSubmit="CanSubmit" DisabledReason="@DisabledReason"
                             OnSubmit="Submit" Result="_result" />
        }
        else if (_method == PublishMethod.Manual)
        {
            <p class="mode-desc">
                Prefer to keep control? No token needed — copy the file below, then open the pull request yourself.
            </p>

            <div class="entry-preview">
                <div class="entry-preview-head">
                    <span>Add this file — <code>registry/@(DisplayId).json</code></span>
                    <button class="btn" @onclick="CopyEntry">📋 Copy JSON</button>
                </div>
                <pre class="entry-json"><code>@PreviewJson</code></pre>
            </div>
            @if (!_entryFieldsReady)
            {
                <p class="install-hint">Fill in your repo URL above — once the manifest is found, this fills in automatically.</p>
            }

            <ol class="steps">
                <li><strong>Copy the JSON above</strong> (📋 button).</li>
                <li>
                    <strong>Create the file</strong> at <code>registry/@(DisplayId).json</code> in the registry —
                    if you don't have write access, GitHub offers to fork it for you (accept).
                </li>
                <li>
                    <strong>Open the pull request</strong> against the <code>@Registry.BaseBranch</code> branch. CI validates
                    your manifest and comments on the PR; a maintainer merges it.
                </li>
            </ol>

            <div class="manual-actions">
                <a class="btn primary @(_entryFieldsReady ? "" : "disabled")"
                   href="@(_entryFieldsReady ? NewFileUrl : null)"
                   target="_blank" rel="noopener"
                   @onclick:preventDefault="@(!_entryFieldsReady)">📝 Create the file on GitHub →</a>
                <a class="btn" href="@GitLinks.PullRequests(Registry.Owner, Registry.Repo)" target="_blank" rel="noopener">Browse open pull requests</a>
            </div>
            <p class="install-hint" style="margin-top:.5rem">
                The one-click button opens GitHub's editor with the path <em>and</em> contents already filled in — review,
                commit, and it walks you straight into the pull request. (Enabled once the id and repo are valid.)
            </p>
        }
        else
        {
            <CliPrPanel ButtonLabel="Open pull request (gh)" Busy="_busy"
                        Ready="CliReady" NotReadyReason="@CliNotReadyReason"
                        CanSubmit="CanSubmitCli" DisabledReason="Enter your repo URL above and wait for the manifest id to be detected."
                        OnSubmit="SubmitCli" Result="_result">
                Open the pull request with your machine's <strong>GitHub CLI</strong> (<code>gh</code>) — no token to
                paste. The store forks the registry if needed, commits the pointer file and opens the PR using your
                existing <code>gh auth login</code>@(_cliStatus?.GhAccount is { } a ? $" (signed in as {a})" : "").
            </CliPrPanel>
        }
    </section>
}
else if (_tab == Tab.Certify)
{
    <section class="panel">
        <h2>Certify a version</h2>
        <p class="install-hint">
            Propose marking a specific <strong>commit</strong> of a published asset as <span class="badge certified">certified</span> —
            a reviewed, immutable, pinned version added to the asset's <code>certified[]</code> list. Only
            <strong>registry maintainers</strong> (CODEOWNERS) can merge it.
        </p>

        <div class="form">
            <label>Asset id<input class="ipt" @bind="_certifyId" @bind:event="oninput" placeholder="com.you.cool-asset" /></label>
            <label>Version label<input class="ipt" @bind="_certifyVersion" @bind:event="oninput" placeholder="1.0.0" /></label>
            <label>Tag (optional)<input class="ipt" @bind="_certifyTag" @bind:event="oninput" placeholder="v1.0.0" /></label>
            <label class="wide">Commit (40-char SHA)<input class="ipt" @bind="_certifyCommit" @bind:event="oninput" placeholder="the immutable commit to certify" /></label>
        </div>
        <p class="install-hint">Never certify a branch — it moves. Pin an exact commit (from a tag/release).</p>

        <MethodPicker @bind-Method="_method" ShowCli="ShowCliTab" />

        @if (_method == PublishMethod.Assisted)
        {
            <AssistedPrPanel Description="Sign in and the store forks the registry, adds the certified entry and opens the PR."
                             ButtonLabel="Open certification PR"
                             Busy="_busy" CanSubmit="CanCertify" DisabledReason="@CertifyDisabledReason"
                             OnSubmit="Certify" Result="_certifyResult" />
        }
        else if (_method == PublishMethod.Manual)
        {
            <p class="mode-desc">No token needed — add the entry to the file yourself, then open the pull request.</p>
            <div class="entry-preview">
                <div class="entry-preview-head">
                    <span>Add this object to the <code>certified</code> array of <code>registry/@(AssetId.IsValid(_certifyId) ? _certifyId : "<id>").json</code></span>
                    <button class="btn" @onclick="() => Copy(CertifySnippet)">📋 Copy</button>
                </div>
                <pre class="entry-json"><code>@CertifySnippet</code></pre>
            </div>
            <ol class="steps">
                <li><strong>Copy the block above.</strong></li>
                <li><strong>Edit</strong> <code>registry/@(AssetId.IsValid(_certifyId) ? _certifyId : "<id>").json</code> on GitHub (it offers to fork if needed) and add the object to its <code>"certified": [ … ]</code> array.</li>
                <li><strong>Commit &amp; open the pull request</strong> against <code>@Registry.BaseBranch</code>.</li>
            </ol>
            <div class="manual-actions">
                <a class="btn primary @(AssetId.IsValid(_certifyId) ? "" : "disabled")"
                   href="@(AssetId.IsValid(_certifyId) ? GitLinks.EditRegistryFile(Registry.Owner, Registry.Repo, Registry.BaseBranch, _certifyId) : null)"
                   target="_blank" rel="noopener" @onclick:preventDefault="@(!AssetId.IsValid(_certifyId))">✏ Edit the file on GitHub →</a>
                <a class="btn" href="@GitLinks.PullRequests(Registry.Owner, Registry.Repo)" target="_blank" rel="noopener">Browse open pull requests</a>
            </div>
        }
        else
        {
            <CliPrPanel ButtonLabel="Open certification PR (gh)" Busy="_busy"
                        Ready="CliReady" NotReadyReason="@CliNotReadyReason"
                        CanSubmit="CanCertifyCli" DisabledReason="Enter the asset id, a version label and the full 40-character commit SHA."
                        OnSubmit="CertifyCli" Result="_certifyResult">
                Add the certified entry and open the PR with your <strong>GitHub CLI</strong> (<code>gh</code>)@(_cliStatus?.GhAccount is { } a ? $", signed in as {a}" : "") — no token needed.
            </CliPrPanel>
        }
    </section>
}
else
{
    <section class="panel">
        <h2>Remove an asset</h2>
        <p class="install-hint">
            Propose removing an asset from the store. This <strong>deletes</strong>
            <code>registry/@(AssetId.IsValid(_removeId) ? _removeId : "<id>").json</code> via a pull request — the asset's
            own repository is untouched, only the registry pointer is removed. Merged by <strong>registry maintainers</strong>.
        </p>

        <div class="form">
            <label class="wide">Asset id<input class="ipt" @bind="_removeId" @bind:event="oninput" placeholder="com.you.cool-asset" /></label>
        </div>

        <MethodPicker @bind-Method="_method" ShowCli="ShowCliTab" />

        @if (_method == PublishMethod.Assisted)
        {
            <AssistedPrPanel Description="Sign in and the store forks the registry, deletes the file and opens the PR."
                             ButtonLabel="Open removal PR"
                             Busy="_busy" CanSubmit="CanRemove" DisabledReason="@RemoveDisabledReason"
                             OnSubmit="Remove" Result="_removeResult" />
        }
        else if (_method == PublishMethod.Manual)
        {
            <p class="mode-desc">No token needed — delete the file on GitHub yourself, then open the pull request.</p>
            <ol class="steps">
                <li><strong>Open</strong> <code>registry/@(AssetId.IsValid(_removeId) ? _removeId : "<id>").json</code> on GitHub.</li>
                <li>Use the <strong>🗑 Delete file</strong> button (top-right of the file view). GitHub offers to fork if you lack write access.</li>
                <li><strong>Commit &amp; open the pull request</strong> against <code>@Registry.BaseBranch</code>.</li>
            </ol>
            <div class="manual-actions">
                <a class="btn primary @(AssetId.IsValid(_removeId) ? "" : "disabled")"
                   href="@(AssetId.IsValid(_removeId) ? GitLinks.RegistryFileBlob(Registry.Owner, Registry.Repo, Registry.BaseBranch, _removeId) : null)"
                   target="_blank" rel="noopener" @onclick:preventDefault="@(!AssetId.IsValid(_removeId))">🗑 Open the file on GitHub →</a>
                <a class="btn" href="@GitLinks.PullRequests(Registry.Owner, Registry.Repo)" target="_blank" rel="noopener">Browse open pull requests</a>
            </div>
        }
        else
        {
            <CliPrPanel ButtonLabel="Open removal PR (gh)" Busy="_busy"
                        Ready="CliReady" NotReadyReason="@CliNotReadyReason"
                        CanSubmit="CanRemoveCli" DisabledReason="Enter the asset's reverse-DNS id."
                        OnSubmit="RemoveCli" Result="_removeResult">
                Open the removal PR with your <strong>GitHub CLI</strong> (<code>gh</code>)@(_cliStatus?.GhAccount is { } a ? $", signed in as {a}" : "") — no token needed.
            </CliPrPanel>
        }
    </section>
}

@code {
    private enum Tab { Publish, Certify, Remove }

    private Tab _tab = Tab.Publish;
    private PublishMethod _method = PublishMethod.Assisted;
    private bool _busy;

    // Local CLI publishing (desktop only). Null status until checked.
    private CliStatus? _cliStatus;
    private bool ShowCliTab => Cli.Supported && Env.InstallAvailable;

    // Publish
    private string _repoUrl = "", _ref = "main";
    private string? _detectedId, _detectError;
    private bool _detecting;
    private CancellationTokenSource? _detectCts;
    private PublishResult? _result;

    // Certify
    private string _certifyId = "", _certifyVersion = "", _certifyTag = "", _certifyCommit = "";
    private PublishResult? _certifyResult;

    // Remove
    private string _removeId = "";
    private PublishResult? _removeResult;

    // Deep-linkable form: /manage?tab=certify&id=com.you.thing&repo=…&ref=v1.0.0 prefills
    // everything, so docs and PR comments can link a ready-to-submit page.
    [SupplyParameterFromQuery(Name = "tab")] public string? UrlTab { get; set; }
    [SupplyParameterFromQuery(Name = "repo")] public string? UrlRepo { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? UrlRef { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public string? UrlId { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public string? UrlVersion { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string? UrlTag { get; set; }
    [SupplyParameterFromQuery(Name = "commit")] public string? UrlCommit { get; set; }

    private void ApplyUrlPrefill()
    {
        _tab = UrlTab?.ToLowerInvariant() switch
        {
            "certify" => Tab.Certify,
            "remove" => Tab.Remove,
            _ => Tab.Publish,
        };
        if (!string.IsNullOrWhiteSpace(UrlRepo)) { _repoUrl = UrlRepo; }
        if (!string.IsNullOrWhiteSpace(UrlRef)) { _ref = UrlRef; }
        if (!string.IsNullOrWhiteSpace(UrlId))
        {
            _certifyId = UrlId;
            _removeId = UrlId;
        }
        if (!string.IsNullOrWhiteSpace(UrlVersion)) { _certifyVersion = UrlVersion; }
        if (!string.IsNullOrWhiteSpace(UrlTag)) { _certifyTag = UrlTag; }
        if (!string.IsNullOrWhiteSpace(UrlCommit)) { _certifyCommit = UrlCommit; }
    }

    /// <summary>Keeps the active tab in the URL (replace navigation) so the page is shareable.</summary>
    private void SelectTab(Tab tab)
    {
        _tab = tab;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab",
            tab == Tab.Publish ? null : tab.ToString().ToLowerInvariant()), replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnChanged;
        ApplyUrlPrefill();
        if (!string.IsNullOrWhiteSpace(_repoUrl))
        {
            _ = DetectIdAsync();
        }
        if (Cli.Supported)
        {
            _cliStatus = await Cli.CheckAsync();
            TryDefaultToCli();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Env needs JS interop, which isn't available during OnInitialized (prerender).
            await Env.InitializeAsync();
            TryDefaultToCli();
        }
    }

    private bool _defaultMethodDecided;

    /// <summary>Desktop with gh ready: the CLI method is the one-click path, make it the default tab.
    /// Decided once both the environment and the CLI check are known — whichever finishes last.</summary>
    private void TryDefaultToCli()
    {
        if (_defaultMethodDecided || !Env.Initialized || (Cli.Supported && _cliStatus is null))
        {
            return;
        }

        _defaultMethodDecided = true;
        if (ShowCliTab && _cliStatus?.ReadyToPublish == true)
        {
            _method = PublishMethod.Cli;
            StateHasChanged();
        }
    }

    // ── CLI publishing (gh) ──────────────────────────────────────────────
    private bool CliReady => _cliStatus?.ReadyToPublish == true;

    private bool CanSubmitCli => CliReady && !_busy && _idIsValid && !string.IsNullOrWhiteSpace(_repoUrl);
    private bool CanCertifyCli => CliReady && !_busy && AssetId.IsValid(_certifyId)
        && !string.IsNullOrWhiteSpace(_certifyVersion) && CommitPattern.IsMatch(_certifyCommit.Trim());
    private bool CanRemoveCli => CliReady && !_busy && AssetId.IsValid(_removeId);

    private string CliNotReadyReason =>
        _cliStatus is null ? "Checking your command-line tools…"
        : !_cliStatus.GitInstalled ? "git was not found on your PATH."
        : !_cliStatus.GhInstalled ? "The GitHub CLI (gh) was not found on your PATH."
        : !_cliStatus.GhAuthenticated ? "gh is installed but not signed in — run `gh auth login`."
        : "";

    private async Task SubmitCli()
    {
        _busy = true;
        _result = null;
        _result = await Cli.PublishAsync(BuildEntry());
        _busy = false;
    }

    private async Task CertifyCli()
    {
        _busy = true;
        _certifyResult = null;
        _certifyResult = await Cli.CertifyAsync(_certifyId.Trim(), new CertifiedVersion
        {
            Version = _certifyVersion.Trim(),
            Tag = string.IsNullOrWhiteSpace(_certifyTag) ? null : _certifyTag.Trim(),
            Commit = _certifyCommit.Trim(),
            CertifiedBy = _cliStatus?.GhAccount,
            CertifiedAt = DateTime.UtcNow.ToString("yyyy-MM-dd"),
        });
        _busy = false;
    }

    private async Task RemoveCli()
    {
        _busy = true;
        _removeResult = null;
        _removeResult = await Cli.RemoveAsync(_removeId.Trim());
        _busy = false;
    }

    // ── Publish ──────────────────────────────────────────────────────────
    private bool _idIsValid => _detectedId is not null;

    private bool _entryFieldsReady => _idIsValid && !string.IsNullOrWhiteSpace(_repoUrl);

    private string DisplayId => _detectedId ?? "<id>";

    private static readonly Regex GitHubRepoPattern = new(
        @"^https?://github\.com/(?<owner>[^/\s]+)/(?<name>[^/\s]+?)(?:\.git)?/?$",
        RegexOptions.Compiled | RegexOptions.IgnoreCase);

    /// <summary>The ref that will be tracked: an explicit ref in the pasted URL wins over an untouched "main".</summary>
    private string EffectiveRef
    {
        get
        {
            var (_, refFromUrl) = NormalizeRepo(_repoUrl);
            return refFromUrl is not null && (string.IsNullOrWhiteSpace(_ref) || _ref == "main")
                ? refFromUrl
                : (string.IsNullOrWhiteSpace(_ref) ? "main" : _ref.Trim());
        }
    }

    /// <summary>Reads the asset id from AssetData/manifest.json at the tracked ref (debounced while typing).</summary>
    private async Task DetectIdAsync()
    {
        if (_detectCts is { } previous)
        {
            previous.Cancel();
            previous.Dispose();
        }

        var cts = _detectCts = new CancellationTokenSource();

        _detectedId = null;
        _detectError = null;
        _detecting = false;

        var (repo, _) = NormalizeRepo(_repoUrl);
        if (string.IsNullOrWhiteSpace(repo))
        {
            return;
        }

        var match = GitHubRepoPattern.Match(repo);
        if (!match.Success)
        {
            _detectError = "Enter a GitHub repository URL (https://github.com/you/YourAsset).";
            return;
        }

        _detecting = true;
        try
        {
            await Task.Delay(500, cts.Token);

            var raw = $"https://raw.githubusercontent.com/{match.Groups["owner"].Value}/{match.Groups["name"].Value}/{EffectiveRef}/AssetData/manifest.json";
            var manifest = AssetStoreJson.Deserialize<AssetManifest>(await Http.GetStringAsync(raw, cts.Token));

            if (manifest.Id is { } id && AssetId.IsValid(id))
            {
                _detectedId = id;
            }
            else
            {
                _detectError = "manifest.json was found, but its id is missing or not reverse-DNS (com.you.cool-asset).";
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            _detectError = "Couldn't read AssetData/manifest.json at that ref — is it committed and pushed?";
        }
        finally
        {
            if (!cts.IsCancellationRequested)
            {
                _detecting = false;
            }
        }
    }

    private RegistryEntry BuildEntry()
    {
        var (repo, _) = NormalizeRepo(_repoUrl);
        return new RegistryEntry
        {
            Id = DisplayId,
            Repo = repo,
            Latest = new RefPointer { Ref = EffectiveRef },
        };
    }

    private string EntryJson => AssetStoreJson.Serialize(BuildEntry());

    private string PreviewJson
    {
        get
        {
            var (repo, _) = NormalizeRepo(_repoUrl);
            return AssetStoreJson.Serialize(new RegistryEntry
            {
                Id = DisplayId,
                Repo = string.IsNullOrWhiteSpace(repo) ? "https://github.com/you/CoolAsset" : repo,
                Latest = new RefPointer { Ref = EffectiveRef },
            });
        }
    }

    private string NewFileUrl =>
        GitLinks.NewRegistryFile(Registry.Owner, Registry.Repo, Registry.BaseBranch, DisplayId, EntryJson);

    private bool CanSubmit =>
        Auth.IsSignedIn && !_busy && _idIsValid && !string.IsNullOrWhiteSpace(_repoUrl);

    private string DisabledReason
    {
        get
        {
            if (!Auth.IsSignedIn) return "Sign in with a GitHub token to submit.";
            if (string.IsNullOrWhiteSpace(_repoUrl)) return "Enter your asset repo URL.";
            if (_detecting) return "Reading AssetData/manifest.json…";
            if (!_idIsValid) return _detectError ?? "Waiting for the asset id to be detected from your manifest.";
            return "";
        }
    }

    private async Task CopyEntry() => await Env.CopyAsync(_entryFieldsReady ? EntryJson : PreviewJson);

    private async Task Copy(string text) => await Env.CopyAsync(text);

    private async Task CopyReadmeTemplate() => await Env.CopyAsync(ReadmeTemplate);

