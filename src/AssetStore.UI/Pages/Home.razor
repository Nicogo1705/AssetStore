@page "/"
@implements IDisposable
@inject CatalogState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Community Stride Asset Store</PageTitle>

<h1 class="sr-only">Browse assets</h1>

@if (State.Loading)
{
    <p class="notice">Loading catalog…</p>
}
else if (State.Error is not null)
{
    <p class="notice error">Failed to load catalog: @State.Error</p>
}
else if (State.Catalog is not null)
{
    var catalog = State.Catalog;
    var results = catalog.Query(BuildQuery());

    @if (State.FromCache)
    {
        <div class="cache-note">⚠ Offline — showing the last cached catalog.</div>
    }

    @if (IsDefaultView && catalog.Assets.Count > 0 && _heroDismissed == false)
    {
        <section class="hero">
            <button type="button" class="banner-close hero-close" title="Hide this intro" @onclick="DismissHeroAsync">✕</button>
            <h2>Community-built assets for Stride</h2>
            <p>
                Decentralized and git-native — every asset lives in its author's own repository,
                pinned by commit and content hash.
                <span class="badge certified"
                      title="Certified: the version was reviewed by the registry maintainers and is pinned to an immutable commit.">✔ certified</span>
                entries have been reviewed by the registry maintainers.
            </p>
            <div class="hero-actions">
                <a class="btn primary" href="manage">Publish an asset</a>
                <a class="btn" href="about">How it works</a>
            </div>
        </section>
    }

    <div class="toolbar">
        <input type="text" placeholder="Search assets…" aria-label="Search assets" @bind="_text" @bind:event="oninput" @bind:after="SyncUrl" />
        <select @bind="_category" @bind:after="SyncUrl" aria-label="Filter by category">
            <option value="">All categories</option>
            @foreach (var c in catalog.Categories)
            {
                <option value="@c">@c</option>
            }
        </select>
        <select @bind="_stride" @bind:after="SyncUrl" aria-label="Filter by minimum Stride version">
            <option value="">Any Stride</option>
            @foreach (var sv in catalog.StrideVersions)
            {
                <option value="@sv">≥ @sv</option>
            }
        </select>
        <select @bind="_license" @bind:after="SyncUrl" aria-label="Filter by license">
            <option value="">Any license</option>
            @foreach (var l in catalog.Licenses)
            {
                <option value="@l">@l</option>
            }
        </select>
        <select @bind="_sort" @bind:after="SyncUrl" aria-label="Sort by">
            <option value="Showcase">Sort: Showcase</option>
            <option value="Recent">Sort: Recently updated</option>
            <option value="NewArrivals">Sort: New arrivals</option>
            <option value="Trending">Sort: Trending (7d ★)</option>
            <option value="Stars">Sort: Stars</option>
            <option value="Name">Sort: Name</option>
            <option value="Category">Sort: Category</option>
            <option value="Size">Sort: Lightweight first</option>
            <option value="Dependencies">Sort: Self-contained first</option>
            <option value="Shuffle">Sort: Discover (shuffle)</option>
        </select>
        <label><input type="checkbox" @bind="_searchDescription" @bind:after="SyncUrl" /> Search descriptions</label>
        <select @bind="_certified" @bind:after="SyncUrl" aria-label="Certification filter">
            <option value="">Certified: all</option>
            <option value="only">✔ Certified only</option>
            <option value="community">Community only</option>
        </select>
    </div>

    <div class="active-tags">
        @if (_author.Length > 0)
        {
            <span class="lbl">Author:</span>
            <button type="button" class="tag-chip active" title="Remove the author filter"
                    @onclick="ClearAuthor">@_author ✕</button>
        }
        <span class="lbl">Tags:</span>
        @foreach (var tag in _tags)
        {
            <button type="button" class="tag-chip active" title="Remove this tag filter"
                    @onclick="() => RemoveTag(tag)">#@tag ✕</button>
        }
        <input class="ipt" style="max-width:11rem;padding:.25rem .6rem;font-size:.85rem"
               list="tag-suggestions" placeholder="＋ filter by tag…"
               title="Type to see matching tags, pick one or press Enter — commas add several at once"
               @bind="_tagInput" @bind:event="oninput" @onkeydown="OnTagInputKey" @onchange="CommitTagInput" />
        <datalist id="tag-suggestions">
            @foreach (var tag in catalog.Tags.Where(t => !_tags.Contains(t, StringComparer.Ordinal)))
            {
                <option value="@tag" />
            }
        </datalist>
    </div>

    <p class="tag">
        @results.Count asset(s)@(catalog.Assets.Count > 0 ? $" · catalog {catalog.GeneratedAt}" : "")
        @if (_sort == "Shuffle")
        {
            <button type="button" class="tag-chip" style="margin-left:.6rem" title="Draw a new random order"
                    @onclick="() => _shuffleSeed = Random.Shared.Next()">🎲 Shuffle again</button>
        }
    </p>

    @if (catalog.Assets.Count == 0)
    {
        <p class="notice">No assets published yet — be the first to <a href="publish">publish one</a>.</p>
    }
    else if (results.Count == 0)
    {
        <p class="notice">No assets match your filters.</p>
    }
    else
    {
        @if (_sort == "Showcase")
        {
            var certifiedAssets = ShowcaseOrder(results.Where(a => a.Certified.Count > 0));
            var otherAssets = ShowcaseOrder(results.Where(a => a.Certified.Count == 0));
            @if (certifiedAssets.Count > 0)
            {
                <h2 class="row-title">✔ Certified
                    <span class="tag" style="font-weight:normal;margin-left:.6rem"
                          title="Trending-weighted shuffle — reshuffles every hour.">
                        ↻ refresh in @MinutesToNextHour min
                    </span>
                </h2>
                <div class="grid">
                    @foreach (var asset in certifiedAssets)
                    {
                        <AssetCard Asset="asset" OnTagClick="AddTag" @key="@($"c-{asset.Id}")" />
                    }
                </div>
            }
            @if (otherAssets.Count > 0)
            {
                <h2 class="row-title">All assets</h2>
                <div class="grid">
                    @foreach (var asset in otherAssets)
                    {
                        <AssetCard Asset="asset" OnTagClick="AddTag" @key="asset.Id" />
                    }
                </div>
            }
        }
        else
        {
            <div class="grid">
                @foreach (var asset in results)
                {
                    <AssetCard Asset="asset" OnTagClick="AddTag" @key="asset.Id" />
                }
            </div>
        }
    }
}

@code {
    private const string DefaultSort = "Showcase";

    // Stable for the lifetime of the app instance, so "Discover" keeps its order while browsing.
    private int _shuffleSeed = Random.Shared.Next();

    private string _text = "";
    private string _category = "";
    private string _license = "";
    private string _sort = DefaultSort;
    private string _stride = "";
    private string _certified = "";
    private bool _searchDescription = true;
    private string _author = "";
    private readonly List<string> _tags = [];

    private void ClearAuthor()
    {
        _author = "";
        SyncUrl();
    }

    // The URL is the source of truth: every control change is pushed into the query string
    // (replace navigation), so filters survive a refresh and links are shareable.
    [SupplyParameterFromQuery(Name = "q")] public string? UrlText { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? UrlCategory { get; set; }
    [SupplyParameterFromQuery(Name = "license")] public string? UrlLicense { get; set; }
    [SupplyParameterFromQuery(Name = "stride")] public string? UrlStride { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? UrlSort { get; set; }
    [SupplyParameterFromQuery(Name = "certified")] public string? UrlCertified { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? UrlSearchDescription { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string[]? UrlTags { get; set; }
    [SupplyParameterFromQuery(Name = "author")] public string? UrlAuthor { get; set; }

    protected override void OnParametersSet()
    {
        _text = UrlText ?? "";
        _category = UrlCategory ?? "";
        _license = UrlLicense ?? "";
        _stride = UrlStride ?? "";
        _author = UrlAuthor ?? "";
        _sort = Enum.TryParse<CatalogSort>(UrlSort, ignoreCase: true, out var sort) ? sort.ToString() : DefaultSort;
        _certified = UrlCertified is "only" or "community" ? UrlCertified : "";
        _searchDescription = UrlSearchDescription ?? true;
        _tags.Clear();
        _tags.AddRange((UrlTags ?? []).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct(StringComparer.Ordinal));
    }

    /// <summary>True when nothing is searched/filtered (default landing view) — the hero and the
    /// certified row only show there, so they never get in the way of an actual search.</summary>
    private bool IsDefaultView =>
        _text.Length == 0 && _category.Length == 0 && _license.Length == 0 && _stride.Length == 0
        && _certified.Length == 0 && _tags.Count == 0 && _author.Length == 0 && _sort == DefaultSort;

    private void SyncUrl() => Nav.NavigateTo(
        Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = _text.Length == 0 ? null : _text,
            ["category"] = _category.Length == 0 ? null : _category,
            ["license"] = _license.Length == 0 ? null : _license,
            ["stride"] = _stride.Length == 0 ? null : _stride,
            ["sort"] = _sort == DefaultSort ? null : _sort,
            ["certified"] = _certified.Length == 0 ? null : _certified,
            ["desc"] = _searchDescription ? null : false,
            ["author"] = _author.Length == 0 ? null : _author,
            ["tag"] = _tags.Count == 0 ? null : _tags.ToArray(),
        }),
        replace: true);

    private string _tagInput = "";
    private System.Threading.Timer? _showcaseTimer;

    private static int MinutesToNextHour => 60 - DateTime.UtcNow.Minute;

    /// <summary>
    /// Showcase ordering: a weighted shuffle reseeded every hour (UTC), each asset's weight
    /// driven by its 7-day star trend — trending assets surface first more often, but every
    /// asset rotates through. Deterministic within the hour (stable across re-renders and
    /// reloads) via a seeded per-asset key (Efraimidis–Spirakis: key = u^(1/weight)).
    /// </summary>
    private static IReadOnlyList<IndexedAsset> ShowcaseOrder(IEnumerable<IndexedAsset> assets)
    {
        // Deprecated assets stay findable through search/sorts but are not promoted here.
        assets = assets.Where(a => a.Deprecated is null);
        var now = DateTime.UtcNow;
        var seed = (now.Year * 1000 + now.DayOfYear) * 100 + now.Hour;
        return assets
            .Select(a => (Asset: a,
                Key: Math.Pow(StableUnit(a.Id, seed), 1.0 / (1 + Core.Indexing.StarsHistory.SevenDayDelta(a)))))
            .OrderByDescending(x => x.Key)
            .Select(x => x.Asset)
            .ToList();
    }

    /// <summary>Deterministic per-(asset, seed) value in (0,1) — FNV-1a, NOT string.GetHashCode
    /// (whose randomization would reshuffle on every page load).</summary>
    private static double StableUnit(string id, int seed)
    {
        unchecked
        {
            var h = 2166136261u;
            foreach (var ch in id)
            {
                h = (h ^ ch) * 16777619u;
            }
            h ^= (uint)seed * 2654435761u;
            h = (h ^ (h >> 13)) * 1274126177u;
            return ((h >> 8) + 0.5) / 16777216.0;
        }
    }

    private void OnTagInputKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            CommitTagInput();
        }
    }

    /// <summary>
    /// Commits the tag box as filter(s): Enter, or picking a datalist suggestion (change event).
    /// Commas add several at once ("pbr, water" → #pbr + #water); values are normalized like
    /// clicked chips (trimmed, no leading #, lowercase).
    /// </summary>
    private void CommitTagInput()
    {
        var added = false;
        foreach (var raw in _tagInput.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var tag = raw.TrimStart('#').Trim().ToLowerInvariant();
            if (tag.Length > 0 && !_tags.Contains(tag, StringComparer.Ordinal))
            {
                _tags.Add(tag);
                added = true;
            }
        }

        _tagInput = "";
        if (added)
        {
            SyncUrl();
        }
    }

    private void AddTag(string tag)
    {
        if (!_tags.Contains(tag, StringComparer.Ordinal))
        {
            _tags.Add(tag);
            SyncUrl();
        }
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
        SyncUrl();
    }

    // null until the stored preference is read — the hero only renders once we KNOW it wasn't
    // dismissed, so it never flashes in and out.
    private bool? _heroDismissed;

    private async Task DismissHeroAsync()
    {
        _heroDismissed = true;
        await JS.InvokeVoidAsync("assetStoreEnv.setPref", "dismissed.hero", "1");
    }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        // Ticks the "refresh in X min" counter and reshuffles the showcase on the hour.
        _showcaseTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(60 - DateTime.UtcNow.Second), TimeSpan.FromMinutes(1));
        await State.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _heroDismissed = await JS.InvokeAsync<string?>("assetStoreEnv.getPref", "dismissed.hero") == "1";
        }
        catch
        {
            _heroDismissed = false; // cosmetic — show the hero if interop isn't available
        }

        StateHasChanged();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private CatalogQuery BuildQuery() => new()
    {
        Text = _text,
        Tags = _tags,
        Author = string.IsNullOrEmpty(_author) ? null : _author,
        Category = string.IsNullOrEmpty(_category) ? null : _category,
        License = string.IsNullOrEmpty(_license) ? null : _license,
        Certified = _certified switch
        {
            "only" => CertifiedFilter.CertifiedOnly,
            "community" => CertifiedFilter.CommunityOnly,
            _ => CertifiedFilter.All,
        },
        SearchDescription = _searchDescription,
        StrideVersion = string.IsNullOrEmpty(_stride) ? null : _stride,
        StrideMatch = StrideMatch.AtLeast,
        SortBy = Enum.TryParse<CatalogSort>(_sort, out var sortBy) ? sortBy : CatalogSort.Recent,
        ShuffleSeed = _shuffleSeed,
    };

    public void Dispose()
    {
        State.Changed -= OnChanged;
        _showcaseTimer?.Dispose();
    }
}
