@page "/"
@implements IDisposable
@inject CatalogState State
@inject NavigationManager Nav

<PageTitle>Community Stride Asset Store</PageTitle>

<h1 class="sr-only">Browse assets</h1>

@if (State.Loading)
{
    <p class="notice">Loading catalog…</p>
}
else if (State.Error is not null)
{
    <p class="notice error">Failed to load catalog: @State.Error</p>
}
else if (State.Catalog is not null)
{
    var catalog = State.Catalog;
    var results = catalog.Query(BuildQuery());

    @if (State.FromCache)
    {
        <div class="cache-note">⚠ Offline — showing the last cached catalog.</div>
    }

    @if (IsDefaultView && catalog.Assets.Count > 0)
    {
        <section class="hero">
            <h2>Community-built assets for Stride</h2>
            <p>
                Decentralized and git-native — every asset lives in its author's own repository,
                pinned by commit and content hash.
                <span class="badge certified"
                      title="Certified: the version was reviewed by the registry maintainers and is pinned to an immutable commit.">✔ certified</span>
                entries have been reviewed by the registry maintainers.
            </p>
            <div class="hero-actions">
                <a class="btn primary" href="manage">Publish an asset</a>
                <a class="btn" href="about">How it works</a>
            </div>
        </section>
    }

    <div class="toolbar">
        <input type="text" placeholder="Search assets…" aria-label="Search assets" @bind="_text" @bind:event="oninput" @bind:after="SyncUrl" />
        <select @bind="_category" @bind:after="SyncUrl" aria-label="Filter by category">
            <option value="">All categories</option>
            @foreach (var c in catalog.Categories)
            {
                <option value="@c">@c</option>
            }
        </select>
        <select @bind="_stride" @bind:after="SyncUrl" aria-label="Filter by minimum Stride version">
            <option value="">Any Stride</option>
            @foreach (var sv in catalog.StrideVersions)
            {
                <option value="@sv">≥ @sv</option>
            }
        </select>
        <select @bind="_license" @bind:after="SyncUrl" aria-label="Filter by license">
            <option value="">Any license</option>
            @foreach (var l in catalog.Licenses)
            {
                <option value="@l">@l</option>
            }
        </select>
        <select @bind="_sort" @bind:after="SyncUrl" aria-label="Sort by">
            <option value="Recent">Sort: Recently updated</option>
            <option value="NewArrivals">Sort: New arrivals</option>
            <option value="Trending">Sort: Trending (7d ★)</option>
            <option value="Stars">Sort: Stars</option>
            <option value="Name">Sort: Name</option>
            <option value="Category">Sort: Category</option>
            <option value="Size">Sort: Lightweight first</option>
            <option value="Dependencies">Sort: Self-contained first</option>
            <option value="Shuffle">Sort: Discover (shuffle)</option>
        </select>
        <label><input type="checkbox" @bind="_searchDescription" @bind:after="SyncUrl" /> Search descriptions</label>
        <label><input type="checkbox" @bind="_certifiedOnly" @bind:after="SyncUrl" /> Certified only</label>
    </div>

    @if (_tags.Count > 0 || _author.Length > 0)
    {
        <div class="active-tags">
            @if (_author.Length > 0)
            {
                <span class="lbl">Author:</span>
                <button type="button" class="tag-chip active" title="Remove the author filter"
                        @onclick="ClearAuthor">@_author ✕</button>
            }
            @if (_tags.Count > 0)
            {
                <span class="lbl">Tags:</span>
                @foreach (var tag in _tags)
                {
                    <button type="button" class="tag-chip active" title="Remove this tag filter"
                            @onclick="() => RemoveTag(tag)">#@tag ✕</button>
                }
            }
        </div>
    }

    <p class="tag">@results.Count asset(s)@(catalog.Assets.Count > 0 ? $" · catalog {catalog.GeneratedAt}" : "")</p>

    @if (catalog.Assets.Count == 0)
    {
        <p class="notice">No assets published yet — be the first to <a href="publish">publish one</a>.</p>
    }
    else if (results.Count == 0)
    {
        <p class="notice">No assets match your filters.</p>
    }
    else
    {
        @if (IsDefaultView)
        {
            var certifiedAssets = results.Where(a => a.Certified.Count > 0).Take(4).ToList();
            @if (certifiedAssets.Count > 0)
            {
                <h2 class="row-title">✔ Certified</h2>
                <div class="grid">
                    @foreach (var asset in certifiedAssets)
                    {
                        <AssetCard Asset="asset" OnTagClick="AddTag" @key="@($"c-{asset.Id}")" />
                    }
                </div>
                <h2 class="row-title">All assets</h2>
            }
        }

        <div class="grid">
            @foreach (var asset in results)
            {
                <AssetCard Asset="asset" OnTagClick="AddTag" @key="asset.Id" />
            }
        </div>
    }
}

@code {
    private const string DefaultSort = "Recent";

    // Stable for the lifetime of the app instance, so "Discover" keeps its order while browsing.
    private static readonly int ShuffleSeed = Random.Shared.Next();

    private string _text = "";
    private string _category = "";
    private string _license = "";
    private string _sort = DefaultSort;
    private string _stride = "";
    private bool _certifiedOnly;
    private bool _searchDescription = true;
    private string _author = "";
    private readonly List<string> _tags = [];

    private void ClearAuthor()
    {
        _author = "";
        SyncUrl();
    }

    // The URL is the source of truth: every control change is pushed into the query string
    // (replace navigation), so filters survive a refresh and links are shareable.
    [SupplyParameterFromQuery(Name = "q")] public string? UrlText { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? UrlCategory { get; set; }
    [SupplyParameterFromQuery(Name = "license")] public string? UrlLicense { get; set; }
    [SupplyParameterFromQuery(Name = "stride")] public string? UrlStride { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? UrlSort { get; set; }
    [SupplyParameterFromQuery(Name = "certified")] public bool? UrlCertified { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? UrlSearchDescription { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string[]? UrlTags { get; set; }
    [SupplyParameterFromQuery(Name = "author")] public string? UrlAuthor { get; set; }

    protected override void OnParametersSet()
    {
        _text = UrlText ?? "";
        _category = UrlCategory ?? "";
        _license = UrlLicense ?? "";
        _stride = UrlStride ?? "";
        _author = UrlAuthor ?? "";
        _sort = Enum.TryParse<CatalogSort>(UrlSort, ignoreCase: true, out var sort) ? sort.ToString() : DefaultSort;
        _certifiedOnly = UrlCertified ?? false;
        _searchDescription = UrlSearchDescription ?? true;
        _tags.Clear();
        _tags.AddRange((UrlTags ?? []).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct(StringComparer.Ordinal));
    }

    /// <summary>True when nothing is searched/filtered (default landing view) — the hero and the
    /// certified row only show there, so they never get in the way of an actual search.</summary>
    private bool IsDefaultView =>
        _text.Length == 0 && _category.Length == 0 && _license.Length == 0 && _stride.Length == 0
        && !_certifiedOnly && _tags.Count == 0 && _author.Length == 0 && _sort == DefaultSort;

    private void SyncUrl() => Nav.NavigateTo(
        Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = _text.Length == 0 ? null : _text,
            ["category"] = _category.Length == 0 ? null : _category,
            ["license"] = _license.Length == 0 ? null : _license,
            ["stride"] = _stride.Length == 0 ? null : _stride,
            ["sort"] = _sort == DefaultSort ? null : _sort,
            ["certified"] = _certifiedOnly ? true : null,
            ["desc"] = _searchDescription ? null : false,
            ["author"] = _author.Length == 0 ? null : _author,
            ["tag"] = _tags.Count == 0 ? null : _tags.ToArray(),
        }),
        replace: true);

    private void AddTag(string tag)
    {
        if (!_tags.Contains(tag, StringComparer.Ordinal))
        {
            _tags.Add(tag);
            SyncUrl();
        }
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
        SyncUrl();
    }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private CatalogQuery BuildQuery() => new()
    {
        Text = _text,
        Tags = _tags,
        Author = string.IsNullOrEmpty(_author) ? null : _author,
        Category = string.IsNullOrEmpty(_category) ? null : _category,
        License = string.IsNullOrEmpty(_license) ? null : _license,
        CertifiedOnly = _certifiedOnly,
        SearchDescription = _searchDescription,
        StrideVersion = string.IsNullOrEmpty(_stride) ? null : _stride,
        StrideMatch = StrideMatch.AtLeast,
        SortBy = Enum.Parse<CatalogSort>(_sort),
        ShuffleSeed = ShuffleSeed,
    };

    public void Dispose() => State.Changed -= OnChanged;
}
