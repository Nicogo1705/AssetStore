@page "/projects"
@implements IDisposable
@inject CatalogState State
@inject DesktopInstaller Installer
@inject ProjectStore Store
@inject AttentionState Attention

<PageTitle>My projects — Community Stride Asset Store</PageTitle>
<a class="back" href="">← Back to catalog</a>
<h1 style="margin:.2rem 0 .3rem">My projects</h1>
<p class="lead">
    Manage the store assets used by your Stride solutions — like a package manager, but for git-native assets.
    Track as many projects as you like; the list is saved on this machine.
</p>

<div class="mp-layout">
    <!-- ───────────── left: tracked projects ───────────── -->
    <aside class="mp-list">
        <div class="mp-list-head">Tracked projects</div>
        @if (_projects.Count == 0)
        {
            <p class="install-hint" style="padding:.6rem .8rem">No projects yet — add one below.</p>
        }
        else
        {
            @foreach (var p in _projects)
            {
                var path = p.Path;
                <div class="mp-item @(string.Equals(path, _selected, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <button class="mp-item-main" @onclick="() => Select(path)" title="@path">
                        <span class="mp-ico">@(p.IsSolution ? "🧩" : "📄")</span>
                        <span class="mp-item-name">@p.Name</span>
                        @if (!p.Exists)
                        {
                            <span class="badge" style="color:var(--warn);border-color:var(--warn)">missing</span>
                        }
                    </button>
                    <button class="mp-remove" title="Stop tracking" @onclick="() => RemoveTracked(path)">✕</button>
                </div>
            }
        }

        <button class="btn mp-add" @onclick="() => _adding = true">＋ Add a project</button>
    </aside>

    <!-- ───────────── right: selected project detail ───────────── -->
    <section class="mp-detail">
        @if (_selected is null)
        {
            <div class="mp-empty">
                <p>Select a project on the left, or add one, to see the store assets it uses.</p>
            </div>
        }
        else
        {
            <div class="mp-detail-head">
                <div>
                    <h2 style="margin:0">@(_view?.Name ?? Path.GetFileName(_selected))</h2>
                    <span class="install-hint mono">@_selected</span>
                </div>
                <div style="display:flex;gap:.4rem">
                    @if (OutdatedAssets.Count > 0)
                    {
                        <button class="btn primary" title="Update every outdated asset of this solution"
                                @onclick="UpdateAll" disabled="@_busy">⟳ Update all (@OutdatedAssets.Count)</button>
                    }
                    <button class="btn" title="Show in Explorer" @onclick="OpenFolder">📂 Folder</button>
                    <button class="btn" title="Open the solution in your IDE" @onclick="OpenSolution">🧩 Open .sln</button>
                    <button class="btn" @onclick="Reload" disabled="@_busy">↻ Refresh</button>
                </div>
            </div>

            @if (!File.Exists(_selected))
            {
                <div class="cache-note">⚠ This file no longer exists on disk. Remove it from the list, or restore it.</div>
            }
            else if (_loading)
            {
                <p class="notice">Analyzing project…</p>
            }
            else if (_view is not null)
            {
                @foreach (var node in _view.Projects)
                {
                    <div class="mp-proj">
                        <div class="mp-proj-head">
                            <span class="mp-ico">📄</span>
                            <span class="mp-proj-name">@node.Name</span>
                            @if (!string.IsNullOrEmpty(node.StrideVersion))
                            {
                                <span class="badge" title="Stride version this project targets">Stride @node.StrideVersion</span>
                            }
                            <span class="install-hint" style="margin:0 0 0 auto">@node.Assets.Count asset(s)</span>
                        </div>

                        @if (node.Dependencies is { Count: > 0 } deps)
                        {
                            <p class="install-hint" style="margin:.15rem 0 .45rem 1.7rem;line-height:1.7" title="Other dependencies of this project (NuGet packages and plain project references)">
                                @string.Join("  ·  ", deps.Select(d => string.IsNullOrEmpty(d.Version) ? d.Name : $"{d.Name} {d.Version}"))
                            </p>
                        }

                        @{
                            // Cached assets not already referenced by this project — attachable without any download.
                            // Excluded by asset id, not clone path: a project referencing v1.0.0 shouldn't be
                            // offered master of the same asset (that's what the ref switcher is for).
                            var attachable = _cache.Where(c => c.Status != "broken"
                                && !node.Assets.Any(a => string.Equals(a.CloneRoot, c.CloneRoot, StringComparison.OrdinalIgnoreCase)
                                    || (!string.IsNullOrEmpty(c.Id) && string.Equals(a.Id, c.Id, StringComparison.OrdinalIgnoreCase)))).ToList();
                            _attachPick.TryAdd(node.CsprojPath, ""); // @bind reads the indexer — the key must exist
                        }
                        @if (attachable.Count > 0)
                        {
                            <div class="mp-attach">
                                <select class="ipt" style="max-width:26rem" @bind="_attachPick[node.CsprojPath]">
                                    <option value="">＋ Add a downloaded asset…</option>
                                    @foreach (var c in attachable)
                                    {
                                        <option value="@c.CloneRoot">@c.Name @(string.IsNullOrEmpty(c.Ref) ? "" : $"({c.Ref})")</option>
                                    }
                                </select>
                                <button class="btn" disabled="@(_busy || string.IsNullOrEmpty(_attachPick.GetValueOrDefault(node.CsprojPath)))"
                                        @onclick="() => AttachCached(node.CsprojPath)">Attach</button>
                            </div>
                        }

                        @if (node.Assets.Count == 0)
                        {
                            <p class="install-hint mp-none">No store assets referenced.
                                <a href="">Browse the catalog →</a> to install one into this project.</p>
                        }
                        else
                        {
                            <div class="mp-assets">
                                @foreach (var a in node.Assets)
                                {
                                    var asset = a;
                                    <div class="mp-asset">
                                        <div class="mp-asset-main">
                                            @if (string.IsNullOrEmpty(asset.Id))
                                            {
                                                <span class="mp-asset-name">@asset.Name</span>
                                            }
                                            else
                                            {
                                                <a class="mp-asset-name" href="@($"a/{Uri.EscapeDataString(asset.Id)}")">@asset.Name</a>
                                            }
                                            <span class="badge @(asset.Kind == "nuget" ? "nuget" : "cat")">@asset.Kind</span>
                                            @if (asset.Kind == "local" && !string.IsNullOrEmpty(asset.Id) && State.Find(asset.Id) is { } catalogEntry)
                                            {
                                                <select class="ipt" style="max-width:9rem;padding:.05rem .4rem;font-size:.78rem"
                                                        title="Ref this project follows for the asset — picking another one downloads it (if needed) and rewires the reference"
                                                        disabled="@_busy" value="@asset.Ref"
                                                        @onchange="e => SwitchRef(node.CsprojPath, asset, (string?)e.Value ?? string.Empty)">
                                                    @if (string.IsNullOrEmpty(asset.Ref))
                                                    {
                                                        <option value="">(legacy)</option>
                                                    }
                                                    @foreach (var reference in RefChoices(catalogEntry))
                                                    {
                                                        <option value="@reference">⑂ @reference@(IsCertifiedRef(catalogEntry, reference) ? " ✓" : "")</option>
                                                    }
                                                </select>
                                            }
                                            else if (asset.Kind == "local" && !string.IsNullOrEmpty(asset.Ref))
                                            {
                                                <span class="badge" title="This clone follows the '@asset.Ref' ref (from its cache path)">⑂ @asset.Ref</span>
                                            }
                                            @if (asset.Status == "outdated")
                                            {
                                                var trackedRef = string.IsNullOrEmpty(asset.Ref) ? State.Find(asset.Id)?.Latest.Ref ?? "main" : asset.Ref;
                                                <span class="badge" style="color:var(--warn);border-color:var(--warn)" title="The '@trackedRef' ref moved — use Update to pull it">outdated</span>
                                            }
                                            else
                                            {
                                                @StatusBadge(asset.Status)
                                            }
                                            @switch (StrideMismatchOf(node, asset))
                                            {
                                                case StrideMismatch.Patch:
                                                    <span class="badge" style="color:var(--warn);border-color:var(--warn)"
                                                          title="This asset targets Stride @asset.StrideVersion, @node.Name targets @node.StrideVersion — same major.minor, but Stride serializer hashes and asset formats can move between builds. Align the versions if anything misbehaves.">
                                                        ⚠ Stride @asset.StrideVersion
                                                    </span>
                                                    break;
                                                case StrideMismatch.MajorMinor:
                                                    <span class="badge" style="color:#fca5a5;border-color:rgba(239,68,68,.5)"
                                                          title="This asset targets Stride @asset.StrideVersion but @node.Name targets @node.StrideVersion — a different major.minor is likely to break (APIs, serializers, asset formats). Update the asset or align your project's Stride version.">
                                                        ⛔ Stride @asset.StrideVersion
                                                    </span>
                                                    break;
                                            }
                                            @if (StrideMismatchOf(node, asset) != StrideMismatch.None)
                                            {
                                                <button class="btn" style="padding:.05rem .5rem;font-size:.75rem" disabled="@_busy"
                                                        title="Align the Stride versions…" @onclick="() => _pendingRetarget = (node, asset)">fix…</button>
                                            }
                                            @if (asset.Kind == "local" && asset.InstalledCommit.Length >= 7)
                                            {
                                                <span class="mono install-hint" style="margin:0">@asset.InstalledCommit[..7]</span>
                                            }
                                            else if (asset.Kind == "nuget" && !string.IsNullOrEmpty(asset.InstalledCommit))
                                            {
                                                <span class="mono install-hint" style="margin:0">v@(asset.InstalledCommit)</span>
                                            }
                                        </div>
                                        <div class="mp-asset-actions">
                                            @if (asset.Status == "outdated")
                                            {
                                                <button class="btn" @onclick="() => Update(asset)" disabled="@_busy">Update</button>
                                            }
                                            @if (asset.Status == "missing" && !string.IsNullOrEmpty(asset.Id))
                                            {
                                                <button class="btn primary" @onclick="() => Download(asset)" disabled="@_busy">⇩ Download</button>
                                            }
                                            <button class="btn" @onclick="() => _pendingUninstall = (node.CsprojPath, asset)" disabled="@_busy">Uninstall</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_view.Dangling.Count > 0)
                {
                    <div class="mp-proj mp-stale">
                        <div class="mp-proj-head">
                            <span class="mp-ico">⚠</span>
                            <span class="mp-proj-name">Stale asset projects</span>
                            <span class="install-hint" style="margin:0 0 0 auto">@_view.Dangling.Count in the solution</span>
                        </div>
                        <p class="install-hint mp-none">
                            Still listed in the solution but their files are gone. If it's a dependency you haven't
                            downloaded yet, download it — otherwise remove the stale entry from the solution.
                        </p>
                        <div class="mp-assets">
                            @foreach (var d in _view.Dangling)
                            {
                                var dang = d;
                                <div class="mp-asset">
                                    <div class="mp-asset-main">
                                        <span class="mp-asset-name" style="opacity:.55">@dang.Name</span>
                                        <span class="badge">missing</span>
                                    </div>
                                    <div class="mp-asset-actions">
                                        @if (dang.AssetId is not null)
                                        {
                                            <button class="btn" @onclick="() => DownloadDangling(dang)" disabled="@_busy">⇩ Download</button>
                                        }
                                        <button class="btn" @onclick="() => RemoveDangling(dang)" disabled="@_busy">Remove from solution</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            @if (_message is not null)
            {
                <p class="install-hint" style="margin-top:.8rem">@_message</p>
            }
        }
    </section>
</div>

@* ── Add a project (roomy file browser in a popup) ── *@
<Modal Visible="_adding" Title="Add a project" Size="wide" OnClose="() => _adding = false">
    <p class="install-hint" style="margin-top:0">Pick a <span class="mono">.sln</span> or <span class="mono">.slnx</span> to track.</p>
    <FileBrowser FilesSelectable="true" SolutionsOnly="true" StorageKey="assetstore.projects.dir" OnFilePicked="AddPicked" />
</Modal>

@* ── Uninstall: everything is decided BEFORE anything is touched (backdrop/✕ = cancel) ── *@
<Modal Visible="@(_pendingUninstall is not null)" Title="@($"Uninstall {_pendingUninstall?.Asset.Name}?")"
       OnClose="() => _pendingUninstall = null">
    @if (_pendingUninstall is { } pending)
    {
        <p style="margin-top:0">
            Remove <strong>@pending.Asset.Name</strong> from
            <strong>@Path.GetFileName(pending.Csproj)</strong>?
        </p>
        @if (pending.Asset.Kind == "local")
        {
            <p class="install-hint">
                The reference is removed from the <span class="mono">.csproj</span> (and from the solution when no
                other project here still uses it). The shared clone
                <span class="mono">@pending.Asset.CloneRoot</span> can be kept for other projects — or deleted too.
            </p>
        }
        <div class="modal-foot">
            <button class="btn" @onclick="() => _pendingUninstall = null" disabled="@_busy">Cancel</button>
            <button class="btn" @onclick="() => ConfirmUninstall(deleteClone: false)" disabled="@_busy">Remove reference only</button>
            @if (pending.Asset.Kind == "local" && !string.IsNullOrEmpty(pending.Asset.CloneRoot))
            {
                <button class="btn primary" @onclick="() => ConfirmUninstall(deleteClone: true)" disabled="@_busy">
                    @(_busy ? "Removing…" : "Remove + delete shared asset")
                </button>
            }
        </div>
    }
</Modal>

@* ── Stride retarget: pick WHICH side to align (backdrop/✕ = cancel) ── *@
<Modal Visible="@(_pendingRetarget is not null)" Title="Align Stride versions" OnClose="() => _pendingRetarget = null">
    @if (_pendingRetarget is { } pending)
    {
        <p style="margin-top:0">
            <strong>@pending.Asset.Name</strong> targets Stride <strong>@pending.Asset.StrideVersion</strong>,
            while <strong>@pending.Node.Name</strong> targets Stride <strong>@pending.Node.StrideVersion</strong>.
        </p>
        <p class="install-hint">
            ⚠ The asset clone is <strong>shared</strong> (<span class="mono">@pending.Asset.CloneRoot</span>):
            retargeting it affects <strong>every project referencing this clone</strong> — they'll be
            re-checked right after so any new mismatch shows up. It's a git clone, so
            <span class="mono">git checkout .</span> inside it reverts.
            Retargeting the project instead changes this project's Stride for everything it builds.
        </p>
        <div class="modal-foot">
            <button class="btn" @onclick="() => _pendingRetarget = null" disabled="@_busy">Cancel</button>
            <button class="btn" @onclick="() => ConfirmRetarget(retargetAsset: false)" disabled="@_busy">
                Project → Stride @pending.Asset.StrideVersion
            </button>
            <button class="btn primary" @onclick="() => ConfirmRetarget(retargetAsset: true)" disabled="@_busy">
                Asset clone → Stride @pending.Node.StrideVersion
            </button>
        </div>
    }
</Modal>

@* ── Error popup ── *@
<Modal Visible="@(_error is not null)" Title="Something went wrong" OnClose="() => _error = null">
    <p style="margin-top:0" class="notice error">@_error</p>
    <div class="modal-foot">
        <button class="btn primary" @onclick="() => _error = null">OK</button>
    </div>
</Modal>

@code {
    private IReadOnlyList<TrackedProject> _projects = [];
    private string? _selected;
    private SolutionView? _view;
    private IReadOnlyList<CachedAsset> _cache = [];
    private readonly Dictionary<string, string> _attachPick = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading;
    private bool _busy;
    private bool _adding;
    private string? _message;
    private (string Csproj, ProjectAsset Asset)? _pendingUninstall;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.EnsureLoadedAsync();
        _projects = Store.List();
        var first = _projects.FirstOrDefault(p => p.Exists) ?? _projects.FirstOrDefault();
        if (first is not null)
        {
            await Select(first.Path);
        }
    }

    private IReadOnlyDictionary<string, IndexedAsset> Catalog =>
        State.Catalog?.Assets.ToDictionary(a => a.Id, StringComparer.Ordinal)
        ?? new Dictionary<string, IndexedAsset>();

    private async Task Select(string path)
    {
        _selected = path;
        _message = null;
        _pendingUninstall = null;
        await Analyze();
    }

    private async Task Reload()
    {
        _message = null;
        _pendingUninstall = null;
        await Analyze();
    }

    private async Task Analyze()
    {
        if (_selected is null || !File.Exists(_selected))
        {
            _view = null;
            return;
        }

        _loading = true;
        StateHasChanged();
        var path = _selected;
        var catalog = Catalog;
        var (view, cache) = await Task.Run(() =>
            (Installer.Analyze(path, catalog), Installer.ListCachedAssets(catalog)));

        // A newer selection may have started while this was running — don't clobber it with a stale result.
        if (!string.Equals(_selected, path, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _view = view;
        _cache = cache;
        _loading = false;
        _ = Attention.RefreshAsync(); // every action re-analyzes, so the nav dots follow reality
    }

    private async Task AttachCached(string csprojPath)
    {
        if (_attachPick.GetValueOrDefault(csprojPath) is not { Length: > 0 } cloneRoot)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var catalog = Catalog;
            var solution = _selected;
            var result = await Task.Run(() => Installer.AttachCached(cloneRoot, [csprojPath], catalog, solution));
            _message = string.Join(" ", result.Messages);
            _attachPick.Remove(csprojPath);
            await Analyze();
        }
        catch (Exception ex)
        {
            _error = $"Attach failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddPicked(FsEntry e)
    {
        var added = Store.Add(e.Path);
        _projects = Store.List();
        _adding = false;
        await Select(added);
    }

    private async Task RemoveTracked(string path)
    {
        Store.Remove(path);
        _projects = Store.List();
        if (string.Equals(path, _selected, StringComparison.OrdinalIgnoreCase))
        {
            _selected = null;
            _view = null;
            var next = _projects.FirstOrDefault(p => p.Exists) ?? _projects.FirstOrDefault();
            if (next is not null)
            {
                await Select(next.Path);
            }
        }
    }

    /// <summary>Outdated local assets of the selected solution, one entry per shared clone
    /// (several projects can reference the same clone — it only needs one pull).</summary>
    private IReadOnlyList<ProjectAsset> OutdatedAssets => _view is null
        ? []
        : _view.Projects.SelectMany(p => p.Assets)
            .Where(a => a.Status == "outdated" && a.Kind == "local" && !string.IsNullOrEmpty(a.CloneRoot))
            .DistinctBy(a => a.CloneRoot, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private (ProjectNode Node, ProjectAsset Asset)? _pendingRetarget;

    private static IReadOnlyList<string> RefChoices(IndexedAsset entry)
    {
        var refs = new List<string> { entry.Latest.Ref };
        refs.AddRange(entry.Versions.Select(v => v.Tag));
        return refs.Distinct(StringComparer.Ordinal).ToList();
    }

    private static bool IsCertifiedRef(IndexedAsset entry, string reference) =>
        entry.Certified.Any(c => string.Equals(c.Tag, reference, StringComparison.Ordinal));

    /// <summary>Rewires this project onto another ref of the asset (downloading that ref's clone
    /// into the versioned cache when needed).</summary>
    private async Task SwitchRef(string csprojPath, ProjectAsset asset, string newRef)
    {
        if (string.IsNullOrEmpty(newRef) || string.Equals(newRef, asset.Ref, StringComparison.Ordinal))
        {
            return;
        }

        var entry = State.Find(asset.Id);
        if (entry is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var catalog = Catalog;
            var solution = _selected;
            var result = await Task.Run(() => Installer.SwitchRef(entry, asset, csprojPath, newRef, catalog, solution));
            _message = string.Join(" ", result.Messages);
            await Analyze();
        }
        catch (Exception ex)
        {
            _error = $"Switch failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Applies the retarget choice, then re-analyzes so every affected project (this one,
    /// and any other referencing the shared clone) shows its fresh mismatch state.</summary>
    private async Task ConfirmRetarget(bool retargetAsset)
    {
        if (_pendingRetarget is not { } pending)
        {
            return;
        }

        var (node, asset) = pending;
        _busy = true;
        _message = null;
        try
        {
            var count = await Task.Run(() => retargetAsset
                ? Installer.RetargetStride(Installer.CloneCsprojs(asset.CloneRoot), node.StrideVersion!)
                : Installer.RetargetStride([node.CsprojPath], asset.StrideVersion!));
            _message = retargetAsset
                ? $"Retargeted {count} project file(s) of the shared clone to Stride {node.StrideVersion}. Other projects using this clone are affected too — their rows below reflect the new state."
                : $"Retargeted {node.Name} to Stride {asset.StrideVersion}.";
            _pendingRetarget = null;
            await Analyze();
        }
        catch (Exception ex)
        {
            _pendingRetarget = null;
            _error = $"Retarget failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UpdateAll()
    {
        _busy = true;
        _message = null;
        try
        {
            var updated = 0;
            var failed = new List<string>();
            foreach (var asset in OutdatedAssets)
            {
                var reference = string.IsNullOrEmpty(asset.Ref)
                    ? State.Find(asset.Id)?.Latest.Ref ?? "main"
                    : asset.Ref;
                var commit = await Task.Run(() => Installer.UpdateInstalled(asset.CloneRoot, reference));
                if (commit is null)
                {
                    failed.Add(asset.Name);
                }
                else
                {
                    updated++;
                }
            }

            _message = $"Updated {updated} asset(s)."
                + (failed.Count > 0 ? $" Failed: {string.Join(", ", failed)} (offline, or the ref is gone)." : "");
            await Analyze();
        }
        catch (Exception ex)
        {
            _error = $"Update all failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Update(ProjectAsset asset)
    {
        _busy = true;
        _message = null;
        try
        {
            // A clone in the versioned cache follows the ref baked into its path; legacy clones follow latest.
            var reference = string.IsNullOrEmpty(asset.Ref)
                ? State.Find(asset.Id)?.Latest.Ref ?? "main"
                : asset.Ref;
            var commit = await Task.Run(() => Installer.UpdateInstalled(asset.CloneRoot, reference));
            _message = commit is null
                ? null
                : $"Updated {asset.Name} to {(commit is { Length: >= 7 } ? commit[..7] : reference)}.";
            if (commit is null)
            {
                _error = $"Couldn't update {asset.Name} — the git fetch/reset failed (offline, or the ref is gone).";
            }

            await Analyze();
        }
        catch (Exception ex)
        {
            _error = $"Update failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Download(ProjectAsset asset)
    {
        var catalogAsset = State.Find(asset.Id);
        if (catalogAsset is null)
        {
            _error = $"{asset.Name} is not in the catalog, so it can't be downloaded automatically.";
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var catalog = Catalog;
            var solution = _selected; // register the fetched projects in the current solution too
            var result = await Task.Run(() => Installer.DownloadToCache(catalogAsset, catalog, solution));
            _message = result.Success
                ? $"Downloaded {asset.Name} into the global cache."
                : string.Join(" ", result.Messages);
            await Analyze();
        }
        catch (Exception ex)
        {
            _error = $"Download failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveDangling(StoreSolutionProject d)
    {
        if (_selected is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var sln = _selected;
            var ok = await Task.Run(() => Installer.RemoveFromSolution(sln, d.CsprojPath));
            _message = ok
                ? $"Removed {d.Name} from the solution."
                : $"Couldn't remove {d.Name} from the solution.";
            await Analyze();
        }
        catch (Exception ex)
        {
            _error = $"Remove failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadDangling(StoreSolutionProject d)
    {
        if (d.AssetId is null)
        {
            return;
        }

        var catalogAsset = State.Find(d.AssetId);
        if (catalogAsset is null)
        {
            _error = $"{d.Name} is not in the catalog, so it can't be downloaded automatically.";
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var catalog = Catalog;
            var solution = _selected;
            var result = await Task.Run(() => Installer.DownloadToCache(catalogAsset, catalog, solution));
            _message = result.Success
                ? $"Downloaded {d.Name} into the global cache."
                : string.Join(" ", result.Messages);
            await Analyze();
        }
        catch (Exception ex)
        {
            _error = $"Download failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmUninstall(bool deleteClone)
    {
        if (_pendingUninstall is not { } pending)
        {
            return;
        }

        var (csprojPath, asset) = pending;
        _busy = true;
        _message = null;
        try
        {
            var solution = _selected;
            var (changed, slnCleaned, cloneDeleted) = await Task.Run(() =>
            {
                var removed = asset.Kind == "nuget"
                    ? Installer.UninstallNuget(csprojPath, asset.PackageId ?? "")
                    : Installer.UninstallLocal(csprojPath, asset.RawInclude);

                // Once no project of this solution references the asset csproj any more, drop it
                // from the .sln too — otherwise it lingers as a "stale asset project".
                var sln = false;
                if (asset.Kind == "local" && solution is not null
                    && !string.IsNullOrEmpty(asset.ReferencedCsproj)
                    && !CsprojStillReferenced(asset.ReferencedCsproj, exceptCsproj: csprojPath))
                {
                    sln = Installer.RemoveFromSolution(solution, asset.ReferencedCsproj);
                }

                var wiped = false;
                if (deleteClone && asset.Kind == "local" && !string.IsNullOrEmpty(asset.CloneRoot)
                    && !CloneStillReferenced(asset.CloneRoot, exceptCsproj: csprojPath))
                {
                    wiped = Installer.DeleteClone(asset.CloneRoot);
                }

                return (removed, sln, wiped);
            });

            _message = !changed
                ? $"{Path.GetFileName(csprojPath)} did not reference {asset.Name}."
                : $"Removed {asset.Name} from {Path.GetFileName(csprojPath)}."
                  + (slnCleaned ? " Removed it from the solution." : "")
                  + (cloneDeleted ? " Deleted the shared asset folder." : deleteClone ? " The shared folder was kept (still used by another project)." : "");

            _pendingUninstall = null;
            await Analyze();
        }
        catch (Exception ex)
        {
            _pendingUninstall = null;
            _error = $"Uninstall failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>True if a project OTHER than <paramref name="exceptCsproj"/> still references this asset csproj.</summary>
    private bool CsprojStillReferenced(string referencedCsproj, string exceptCsproj) =>
        _view is not null && _view.Projects.Any(p =>
            !string.Equals(p.CsprojPath, exceptCsproj, StringComparison.OrdinalIgnoreCase)
            && p.Assets.Any(a => a.Kind == "local"
                && string.Equals(a.ReferencedCsproj, referencedCsproj, StringComparison.OrdinalIgnoreCase)));

    private bool CloneStillReferenced(string cloneRoot, string exceptCsproj) =>
        _view is not null && _view.Projects.Any(p =>
            !string.Equals(p.CsprojPath, exceptCsproj, StringComparison.OrdinalIgnoreCase)
            && p.Assets.Any(a => a.Kind == "local"
                && string.Equals(a.CloneRoot, cloneRoot, StringComparison.OrdinalIgnoreCase)));

    private enum StrideMismatch { None, Patch, MajorMinor }

    /// <summary>
    /// Severity of the Stride version gap between an asset and its host project.
    /// <see cref="StrideMismatch.Patch"/>: same major.minor but not the same build (orange —
    /// serializer hashes and asset formats can still move). <see cref="StrideMismatch.MajorMinor"/>:
    /// different major.minor per <see cref="StrideVersionMatcher"/> (red — expect breakage).
    /// </summary>
    private static StrideMismatch StrideMismatchOf(ProjectNode node, ProjectAsset asset)
    {
        if (string.IsNullOrEmpty(node.StrideVersion) || string.IsNullOrEmpty(asset.StrideVersion)
            || string.Equals(node.StrideVersion, asset.StrideVersion, StringComparison.OrdinalIgnoreCase))
        {
            return StrideMismatch.None;
        }

        return StrideVersionMatcher.IsCompatible(asset.StrideVersion, node.StrideVersion, StrideMatch.Minor)
            ? StrideMismatch.Patch
            : StrideMismatch.MajorMinor;
    }

    private void OpenFolder()
    {
        try
        {
            System.Diagnostics.Process.Start(
                new System.Diagnostics.ProcessStartInfo("explorer.exe", $"/select,\"{_selected}\"") { UseShellExecute = true });
        }
        catch (Exception ex)
        {
            _error = $"Couldn't open the folder: {ex.Message}";
        }
    }

    private void OpenSolution()
    {
        try
        {
            System.Diagnostics.Process.Start(
                new System.Diagnostics.ProcessStartInfo(_selected!) { UseShellExecute = true });
        }
        catch (Exception ex)
        {
            _error = $"Couldn't open the solution: {ex.Message}";
        }
    }

    private static RenderFragment StatusBadge(string status) => status switch
    {
        "up-to-date" => @<span class="badge certified">up to date</span>,
        "outdated" => @<span class="badge" style="color:var(--warn);border-color:var(--warn)">outdated</span>,
        "broken" => @<span class="badge" style="color:#fca5a5;border-color:rgba(239,68,68,.5)">⛔ incomplete</span>,
        "missing" => @<span class="badge" style="color:var(--accent);border-color:rgba(91,141,239,.5)">⇩ not downloaded</span>,
        _ => @<span class="badge">not in catalog</span>,
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}
